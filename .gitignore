# .gitignore

## Logs

logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

## Diagnostic reports

report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

## Runtime & Process files

pids
*.pid
*.seed
*.pid.lock

## Coverage & Testing output

coverage
*.lcov
.nyc_output
.cache
.parcel-cache

## Dependency directories

node_modules/
jspm_packages/
bower_components
web_modules/

## Compiled binary files

build/Release
dist/
build/

## TypeScript cache and build info

*.tsbuildinfo

## dotenv environment variable files

.env
.env.*
!.env.example

## Optional caches

.npm
.eslintcache
.stylelintcache
.node_repl_history

## Output of 'npm pack'

*.tgz

## Yarn Integrity & cache files

.yarn-integrity
.pnp.*
.yarn/*

## Framework-specific build directories

.next
.nuxt
out
.vuepress/dist
.svelte-kit/
.vitepress/dist
.vitepress/cache
.docusaurus
.serverless/
.fusebox/
.dynamodb/
.firebase/
.tern-port
.vscode-test

## Solidity & Smart Contract build artifacts

artifacts/
cache/
typechain/
*.secret
*.sol.js

## Node modules

/node_modules

## Compilation output

/dist

## pnpm deploy output

/bundle

## Hardhat Build Artifacts

/artifacts

## Hardhat compilation (v2) support directory

/cache

## Typechain output

/types

## Hardhat coverage reports

/coverage

## Ethereum & Blockchain wallet files (sensitive)

keystore/
wallet.json

## Temporary files & backups

*~
.DS_Store
